# Local dev: connects to Postgres via unix socket (trust auth, no password)
DATABASE_URL="postgresql://postgres@localhost:5432/nestora?host=/tmp&schema=public"
JWT_SECRET="dev-super-secret-change-in-prod"
JWT_EXPIRES_IN="7d"
PORT=3000

# Firebase project whose phone-OTP ID tokens we accept (see src/auth/firebase-admin.service.ts).
FIREBASE_PROJECT_ID="nestora-app-2026"

# TEMPORARY: enables POST /api/auth/dev-login, which signs in as any phone with
# NO verification. Local dev only — remove once Firebase phone auth is enabled.
DEV_LOGIN_ENABLED="true"
